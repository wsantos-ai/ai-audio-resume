# Copie para .env.local (desenvolvimento). Em produção, defina estas variáveis no painel da Hostinger.

# MySQL
DB_HOST=localhost
DB_PORT=3306
DB_NAME=visitas
DB_USER=root
DB_PASSWORD=

# Segredo da sessão (cookie criptografado). Mínimo de 32 caracteres. Gere com:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# OpenRouter
OPENROUTER_API_KEY=sk-or-v1-...
# Precisa aceitar entrada de áudio (input_audio)
OPENROUTER_MODEL_TRANSCRIPTION=google/gemini-2.5-flash
# Precisa suportar structured outputs (response_format json_schema)
OPENROUTER_MODEL_SUMMARY=google/gemini-2.5-flash
# Enviados nos headers HTTP-Referer / X-Title (identificação do app na OpenRouter)
APP_URL=http://localhost:3000
APP_NAME=Resumo de Visitas

# Limites por usuário (protegem os créditos da OpenRouter).
# MAX_AUDIO_SECONDS deve ser igual a NEXT_PUBLIC_MAX_AUDIO_SECONDS (usado no navegador).
MAX_AUDIO_SECONDS=900
NEXT_PUBLIC_MAX_AUDIO_SECONDS=900
MAX_VISITS_PER_HOUR=20
